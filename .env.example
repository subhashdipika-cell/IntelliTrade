# ─── MT5 / Vantage ───────────────────────────────────────────────
MT5_TERMINAL_PATH=C:\Program Files\Vantage Markets MT5 Terminal\terminal64.exe

# DEMO profile
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=VantageInternational-Demo

# LIVE / real-money profile (fill in later when you're ready to go live).
# Install a SEPARATE MT5 terminal for live and point this at its terminal64.exe,
# so live is fully isolated from the demo terminal.
MT5_LIVE_TERMINAL_PATH=C:\Program Files\Vantage Markets MT5 Terminal Live\terminal64.exe
MT5_LIVE_LOGIN=
MT5_LIVE_PASSWORD=
MT5_LIVE_SERVER=VantageInternational-Live

# Default active profile on startup. ("DEMO" or "LIVE")
MT5_ACCOUNT_TYPE=DEMO

# Real-money kill switch. Live orders — and switching to the LIVE profile —
# are refused unless this is exactly "true".
ALLOW_LIVE=false

# ─── Obsidian RAG ────────────────────────────────────────────────
OBSIDIAN_VAULT_PATH=E:\Obsidian\Trading_Mind
OBSIDIAN_TRADES_DIR=E:\Obsidian\Trading_Mind\raw\trades
# Auto-log closed trades (regime-tagged) + a weekly backtest snapshot into the
# vault (…\raw\trades and …\raw\backtests) for later analysis. Set false to disable.
OBSIDIAN_AUTOLOG_ENABLED=true

# ─── Telegram alerts ─────────────────────────────────────────────
# Create a bot via @BotFather to get the token. Get your chat id from @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# ─── LLM (Wiki gatekeeper) ───────────────────────────────────────
# OpenAI-compatible. Choose the provider:
#   openrouter → cloud, needs OPENAI_API_KEY (sk-or-...)
#   ollama     → local & free, no key; install Ollama + `ollama pull llama3`
LLM_PROVIDER=openrouter
OPENAI_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
# Primary model is tried first; fallback is used on error / rate-limit.
# OpenRouter examples: openai/gpt-4o-mini ; Ollama examples: llama3 / mistral / qwen2.5
LLM_MODEL=openai/gpt-4o-mini
LLM_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# Strategy Review uses its OWN provider/model (it needs ~500 tokens of JSON, too
# slow on a local CPU model). Defaults to OpenRouter even when the gatekeeper runs
# on Ollama. Leave REVIEW_PROVIDER blank to follow LLM_PROVIDER.
REVIEW_PROVIDER=openrouter
REVIEW_MODEL=openai/gpt-4o-mini

# To run the gatekeeper fully local with Ollama, flip the three lines above to e.g.:
#   LLM_PROVIDER=ollama
#   LLM_MODEL=llama3
#   LLM_MODEL_FALLBACK=qwen2.5

# ─── App ─────────────────────────────────────────────────────────
BASE_CURRENCY=USD
